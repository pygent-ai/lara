connections:
  deepseek-main:
    provider: deepseek
    credential:
      env: DEEPSEEK_API_KEY
    protocols:
      openai_chat_completions:
        base_url: https://api.deepseek.com
    verify_ssl: true

  openai-main:
    provider: openai
    credential:
      env: OPENAI_API_KEY
    protocols:
      openai_responses:
        base_url: https://api.openai.com/v1
      openai_chat_completions:
        base_url: https://api.openai.com/v1
    verify_ssl: true

models:
  deepseek-chat:
    connection: deepseek-main
    model_id: deepseek-chat
    protocol: openai_chat_completions
    provider_options: {}
    capabilities:
      modalities:
        input: [text]
        output: [text]
      streaming:
        output: [text]
      tools:
        call: true
        choice: [auto]
        parallel: false
      structured_output:
        json_object: true
        json_schema: false
      reasoning:
        supported: false
        controllable: false
      limits:
        context_tokens: 65536
        max_output_tokens: 8192

  openai-codex:
    connection: openai-main
    model_id: gpt-5.1-codex
    protocol: openai_responses
    provider_options: {}
    capabilities:
      modalities:
        input: [text]
        output: [text]
      streaming:
        output: [text]
      tools:
        call: true
        choice: [auto]
        parallel: false
      structured_output:
        json_object: true
        json_schema: false
      reasoning:
        supported: false
        controllable: false
      limits:
        context_tokens: 65536
        max_output_tokens: 8192

model_groups:
  coding:
    models: [openai-codex, deepseek-chat]
  economy:
    models: [deepseek-chat]

agent:
  default_alias: dev

agents:
  - alias: dev
    model_request:
      default_model_group: coding
      retry:
        max_attempts_per_model: 2
        attempt_idle_timeout_seconds: 60
        backoff_initial: 0.5
        backoff_maximum: 4
        backoff_multiplier: 2

runtime:
  steering:
    # immediate: steering interrupts the in-flight model/tool step (turns run in memory, no per-turn crash recovery)
    # wait: steering applies at the next processing boundary; turns stay durable and recoverable
    mode: immediate
  approvals:
    enabled: true
    timeout_seconds: 300
    preauthorized_tools: []
