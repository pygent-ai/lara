{
  "name": "lora-workspace",
  "private": true,
  "scripts": {
    "dev": "npm --prefix apps/desktop run dev",
    "desktop": "npm --prefix apps/desktop run dev",
    "desktop:package": "npm --prefix apps/desktop run package:win",
    "desktop:portable": "npm --prefix apps/desktop run package:portable",
    "desktop:package:dir": "npm --prefix apps/desktop run package:dir",
    "lint": "npm --workspaces --if-present run lint",
    "typecheck": "npm --workspaces --if-present run typecheck"
  },
  "workspaces": [
    "apps/*"
  ]
}
